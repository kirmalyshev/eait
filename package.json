{
  "name": "eait",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "description": "eait.fit \u2014 the backend, the contract its clients implement, and the web application.",
  "workspaces": [
    "src/shared",
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "start": "bun run --cwd src/backend start",
    "dev": "bun run --cwd src/backend dev",
    "demo": "bun run --cwd src/backend demo",
    "web": "bun run --cwd src/frontend start",
    "web:build": "bun run --cwd src/frontend build",
    "web:e2e": "playwright test",
    "typecheck": "bun run --cwd src/shared typecheck && bun run --cwd src/backend typecheck && bun run --cwd src/frontend typecheck && tsc -p src/scripts",
    "test": "bun test ./src",
    "check": "bun run i18n:compile && bun run typecheck && bun run web:build && bun run test && bun run openapi --check",
    "openapi": "bun run src/scripts/openapi.ts",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --strict"
  },
  "devDependencies": {
    "@lingui/cli": "^6.7.0",
    "@lingui/conf": "^6.7.0",
    "@lingui/format-po": "^6.7.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "^4.5.4"
  }
}
