# The dev stack's own state and this worktree's derived configuration.
.dev/
.env.worktree
.eait-slot

# The production environment file. It holds the model key and the database password.
.env.prod

# The e2e suite runs Chrome out of here, because /tmp is a tmpfs several worktrees share.
.e2e-tmp/

# Lingui's COMPILED catalogs. Generated from the `.po` by `bun run i18n:compile`, which `check`
# runs — so they are a build artefact, and committing them would put eight machine-written files
# in front of every copy review.
src/shared/locales/*/messages.ts
